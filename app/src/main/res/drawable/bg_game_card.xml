<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable game card: dark-green surface, Emerald outline that brightens while pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_emerald">

    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/brand_primary" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/bg_surface" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/brand_primary_dark" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="16dp" />
        </shape>
    </item>

</ripple>
