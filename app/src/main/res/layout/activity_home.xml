<!-- Modern Floating Bottom Navigation -->
<com.google.android.material.card.MaterialCardView
    android:id="@+id/bottom_navigation_container"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/divider_color"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="7dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:background="@drawable/bg_nav_selected">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_view"
                    android:tint="@color/brand_primary"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="الرئيسية"
                android:textColor="@color/brand_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Store -->
        <LinearLayout
            android:id="@+id/nav_store"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="7dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_sort_by_size"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="المتجر"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- Wallet -->
        <LinearLayout
            android:id="@+id/nav_wallet"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="7dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_save"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="المحفظة"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- Profile -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="7dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="34dp"
                android:gravity="center">

                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:tint="@color/text_secondary"
                    android:contentDescription="@null" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="البروفايل"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
