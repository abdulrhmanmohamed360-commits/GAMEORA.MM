<?xml version="1.0" encoding="utf-8"?>
<!--
     مهم: message_text و message_status لازم يفضلوا Children مباشرين
     لهذا الـ FrameLayout (مش جوه LinearLayout وسيط)، لأن ChatActivity
     بيعمل cast لـ layoutParams بتاعتهم لـ FrameLayout.LayoutParams مباشرة
     (راجع التعليق في ChatActivity.onBindViewHolder). أي تغليف إضافي
     هيكسر الـ cast ده ويسبب ClassCastException وقت الـ scroll.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="16dp"
    android:paddingStart="@dimen/spacing_l"
    android:paddingEnd="@dimen/spacing_l">

    <TextView
        android:id="@+id/message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_m"
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:maxWidth="260dp" />

    <TextView
        android:id="@+id/message_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="42dp"
        android:textSize="11sp"
        android:textColor="@color/text_hint" />
</FrameLayout>
