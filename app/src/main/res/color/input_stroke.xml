<?xml version="1.0" encoding="utf-8"?>
<!-- Outline of text fields: quiet green when idle, Emerald when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/divider_color" />
    <item android:state_focused="true" android:color="@color/brand_primary" />
    <item android:state_hovered="true" android:color="@color/brand_secondary" />
    <item android:color="@color/stroke_input" />
</selector>
