<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Gameora is a dark-only product: black screen, dark-green surfaces, Emerald actions.

        The parent is deliberately the non-DayNight Material theme (which is the dark one).
        The previous DayNight parent made every widget that relied on the theme
        (dialogs, text fields, spinners, bottom sheets, default text) switch to
        dark-on-light styling whenever the phone was in light mode, on top of a black window.
    -->
    <style name="Theme.Gameora" parent="Theme.MaterialComponents.NoActionBar">

        <!-- Brand -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_inverse</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnSecondary">@color/text_inverse</item>
        <item name="colorAccent">@color/brand_primary</item>
        <item name="colorError">@color/error_color</item>
        <item name="colorOnError">@color/text_inverse</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/bg_screen</item>
        <item name="android:windowBackground">@color/bg_screen</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- System bars -->
        <item name="android:statusBarColor">@color/bg_screen</item>
        <item name="android:navigationBarColor">@color/bg_screen</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Controls, cursor, selection, ripples, overscroll -->
        <item name="colorControlNormal">@color/text_hint</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="colorControlHighlight">@color/ripple_emerald</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textColorLink">@color/brand_secondary</item>
        <item name="android:textColorHighlight">@color/ripple_emerald</item>
        <item name="android:colorEdgeEffect">@color/brand_primary</item>

        <!-- Component defaults, so screens pick the look up without per-layout overrides -->
        <item name="materialButtonStyle">@style/Widget.Gameora.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Gameora.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.Gameora.TextInput</item>
        <item name="toolbarStyle">@style/Widget.Gameora.Toolbar</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Gameora.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/Theme.Gameora.Dialog</item>
    </style>

    <style name="Theme.Gameora.NoActionBar" parent="Theme.Gameora" />

    <style name="Theme.Gameora.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSurface">@color/bg_surface_raised</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <style name="Theme.Gameora.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Gameora.BottomSheet</item>
    </style>

    <style name="Widget.Gameora.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/bg_surface</item>
    </style>

    <!--
        Buttons
        letterSpacing is forced to 0 everywhere: Material's default spacing pulls
        connected Arabic letters apart on several Android versions.
    -->
    <style name="Widget.Gameora.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.Gameora.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/brand_secondary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/brand_primary_dark</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_emerald</item>
    </style>

    <!-- Text fields: dark-green fill, quiet outline, Emerald when focused -->
    <style name="Widget.Gameora.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_surface</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
    </style>

    <!-- Toolbar: black, white title, so the content below carries the colour -->
    <style name="Widget.Gameora.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/bg_screen</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.Gameora.ToolbarTitle</item>
        <item name="navigationIconTint">@color/text_primary</item>
    </style>

    <!-- Text -->
    <style name="TextAppearance.Gameora.ToolbarTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Gameora.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Gameora.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Gameora.Price" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>
